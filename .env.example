# ── Supabase ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# ⚠️ server-only — used exclusively in src/lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=""

# ── Stripe ──────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY="price_..."
NEXT_PUBLIC_STRIPE_PRICE_YEARLY="price_..."

# ── Resend (email) ──────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="Acme <noreply@acme.com>"

# ── Cron (weekly summary) ───────────────────────────────
CRON_SECRET=""

# ── Optional: rate limiting (Upstash Redis) ─────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Optional: observability ─────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""

# Set to 1 to skip env validation (e.g. during scaffold/CI structure checks)
# SKIP_ENV_VALIDATION=1
